KC_ADMIN_USERNAME=admin
KC_ADMIN_PASSWORD=change_me

# Used by scripts/KeycloakAuth.ps1 (JML automation - acme-provisioner
# service account credentials)
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=acme
KEYCLOAK_CLIENT_ID=acme-provisioner
KEYCLOAK_CLIENT_SECRET=change_me

# Used by acme-api (Admin Console -> Clients -> acme-api ->
# Credentials). Set as a real environment variable before running
# acme-api - see README "Local Setup". Not read from this file.
# ACME_API_CLIENT_SECRET=change_me
